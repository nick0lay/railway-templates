# Copy to .env and change the passwords before exposing anything.
#   cp .env.example .env

# Credentials for the Navigator UI gateway (http://localhost:8080)
UI_USERNAME=admin
UI_PASSWORD=changeme-ui

# Credentials for the Marqo API + Swagger gateway (http://localhost:8081)
# Keep these DIFFERENT from the UI pair — this password can delete every index.
API_USERNAME=admin
API_PASSWORD=changeme-api

# Marqo image tag. See the Image Tags table in README.md — `latest` is NOT the
# newest build. Current releases ship as `cloud-latest` / `2.24.15-cloud`.
MARQO_IMAGE_TAG=latest

# Marqo Navigator image tag.
NAVIGATOR_IMAGE_TAG=v0.1.19

# Vespa image tag. Pinned to the version Marqo's own tooling generates against.
# Do NOT use `latest`: it currently resolves to 8.736.12, whose status response
# Marqo cannot parse — /health returns 400 on every request while search still
# works, so the cluster looks healthy until something checks it. Trying a newer
# release is fine; verify /health returns 200, and pin before indexing, because
# Vespa will not start on state written by a newer version.
VESPA_IMAGE_TAG=8.431.32

# How many cores each Vespa JVM sizes its thread pools for. Vespa derives pool
# sizes from the host's core count, and Railway hosts report 48 — untuned, that
# reaches Railway's 1000-PID-per-container ceiling and the cluster cannot start.
# Raising this trades headroom for nothing measurable: concurrency is limited by
# Marqo's MARQO_MAX_CONCURRENT_* settings, not by Vespa's thread pools.
VESPA_JVM_PROCESSOR_COUNT=4

# Concurrent requests Marqo accepts per type before returning 429. Marqo's own
# default is 8, which rejects from about 10 concurrent callers. These are set in
# docker-compose.yml; override here to experiment.
#MARQO_MAX_CONCURRENT_SEARCH=32
#MARQO_MAX_CONCURRENT_INDEX=32
