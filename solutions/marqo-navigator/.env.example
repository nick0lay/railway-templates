# Copy to .env and change the passwords before exposing anything.
#   cp .env.example .env

# Credentials for the Navigator UI gateway (http://localhost:8080)
UI_USERNAME=admin
UI_PASSWORD=changeme-ui

# Credentials for the Marqo API + Swagger gateway (http://localhost:8081)
# Keep these DIFFERENT from the UI pair — this password can delete every index.
API_USERNAME=admin
API_PASSWORD=changeme-api

# Marqo image tag. See the Image Tags table in README.md — `latest` is NOT the
# newest build. Current releases ship as `cloud-latest` / `2.24.15-cloud`.
MARQO_IMAGE_TAG=latest

# Marqo Navigator image tag.
NAVIGATOR_IMAGE_TAG=v0.1.19
